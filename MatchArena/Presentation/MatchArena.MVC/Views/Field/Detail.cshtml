@model GetFieldVM

<main class="detail-page-container">
    <a asp-controller="Field" asp-action="Index" class="back-link">← Meydançalara qayıt</a>

    <div class="detail-card detail-header">
        <div class="detail-header-grid-field">
            <div class="detail-avatar-field"><img src="@Model.PrimaryPhoto" alt="Mini Futbol Arena"></div>
            <div class="detail-info">
                <h1 class="detail-title">@Model.Name</h1>
                <p class="detail-location">🏠 @Model.City</p>
                <div class="detail-stats-row">
                    <div class="detail-stat-box stat-primary">
                        <div class="stat-label">Qiymət</div>
                        <div class="stat-value-primary">@Model.PricePerHour₼/saat</div>
                    </div>
                    <div class="detail-stat-box stat-blue">
                        <div class="stat-label">Reytinq</div>
                        <div class="stat-value-blue">⭐ @Model.AverageRating</div>
                    </div>
                    <div class="detail-stat-box stat-orange">
                        <div class="stat-label">Rəylər</div>
                        <div class="stat-value-orange">@Model.TotalRating</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="detail-card">
        <h2 class="detail-card-title">Meydança Şəkilləri</h2>
        <div class="field-images-gallery">
            <div class="auxiliary-images">
                @foreach (var item in Model.AdditionalPhoto)
                {
                    <div class="auxiliary-image-item">
                        <img src="@item" alt="" class="gallery-aux-image">
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="detail-two-column">
        <div class="detail-column">
            <div class="detail-card detail-info-card">
                <h2 class="detail-card-title">Meydança Məlumatları</h2>
                <div class="detail-info-row">
                    <span class="info-label">Şəhər</span>
                    <span class="info-value">@Model.City</span>
                </div>
                <div class="detail-info-row">
                    <span class="info-label">Ünvan</span>
                    <span class="info-value">@Model.Address</span>
                </div>
                <div class="detail-info-row">
                    <span class="info-label">İşçi Saatları</span>
                    <span class="info-value">@Model.StartDate - @Model.EndDate</span>
                </div>
                <div class="detail-info-row detail-info-row-last">
                    <span class="info-label">Telefon</span>
                    <span class="info-value"></span>
                </div>
            </div>

            <div class="detail-card">
                <h2 class="detail-card-title">Rezervasiya Et</h2>
                @if (TempData["Error"] != null)
                {
                    <div class="error-message" style="margin-bottom:12px;">@TempData["Error"]</div>
                }
                <form asp-controller="Reservation" asp-action="Create" method="post">
                    <input type="hidden" name="FieldId" value="@Model.Id" />
                    <div class="form-group" style="margin-bottom:16px;">
                        <label>Boş Saatlar *</label>
                        <select name="ReservedTime" class="form-input" required>
                            <option value="">-- Saat seçin --</option>
                            @foreach (var time in Model.EmptySpace)
                            {
                                <option value="@time.ToString("HH:mm:ss")">@time.ToString("HH:mm")</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn-action-primary" style="width:100%;">Rezerv Et</button>
                </form>
            </div>
        </div>

        <div class="detail-column">
            <div class="detail-card time-slots-card">
                <h2 class="detail-card-title">Boş Saatlar</h2>
                <div class="time-slots">
                    @foreach (TimeOnly time in Model.EmptySpace)
                    {
                        <button class="time-slot-available">🕐 @time</button>
                    }
                </div>
            </div>

            <div class="detail-card">
                <h2 class="detail-card-title">Rəylər</h2>
                <p class="reviews-summary">@Model.Ratings.TotalRatings rəy (⭐ @Model.Ratings.AverageRating ortalama)</p>

                @if (TempData["Success"] != null)
                {
                    <div class="success-message" style="margin-bottom:12px;">@TempData["Success"]</div>
                }
                @if (TempData["RatingError"] != null)
                {
                    <div class="error-message" style="margin-bottom:12px;">@TempData["RatingError"]</div>
                }

                <form asp-controller="FieldRating" asp-action="PostRating" method="post" style="margin-bottom:24px;">
                    <input type="hidden" name="fieldId" value="@Model.Id" />
                    <div class="form-group" style="margin-bottom:12px;">
                        <div class="form-group" style="margin-bottom:12px;">
                            <label>Reytinq *</label>
                            <select name="Rating" class="form-input" required>
                                <option value="">-- Reytinq seçin --</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom:12px;">
                        <label>Şərh</label>
                        <textarea name="Comment" class="form-input" rows="3"
                                  placeholder="Rəyinizi yazın..."
                                  style="resize:vertical;width:100%;"></textarea>
                    </div>
                    <button type="submit" class="btn-action-primary">Rəy Göndər</button>
                </form>

                <div class="reviews-list">
                    @if (Model.Ratings.Ratings != null && Model.Ratings.Ratings.Any())
                    {
                        foreach (var review in Model.Ratings.Ratings)
                        {
                            <div class="review-item">
                                <div class="review-avatar review-avatar-green">
                                    @review.UserName?.Substring(0, 1).ToUpper()
                                </div>
                                <div class="review-content"> 
                                    <div class="review-author">@review.UserName</div>
                                    <div class="review-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span style="color: @(i <= review.Rating ? "#f59e0b" : "#d1d5db")">★</span>
                                        }
                                    </div>
                                    <div class="review-text">@review.Comment</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color:#6b7280;">Hələ rəy yoxdur.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</main>