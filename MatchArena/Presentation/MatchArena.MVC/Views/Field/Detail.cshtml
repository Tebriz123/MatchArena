@model GetFieldVM
<main class="detail-page-container">
    <a href="fields.html" class="back-link">← Meydançalara qayıt</a>

    <!-- Field Header -->
    <div class="detail-card detail-header">
        <div class="detail-header-grid-field">
            <div class="detail-avatar-field"><img src="assets/img/WhatsApp Şəkil 2025-06-02 saat 15.17.05_c54a2834.jpg" alt="Mini Futbol Arena"></div>

            <div class="detail-info">
                <h1 class="detail-title">Mini Futbol Arena</h1>
                <p class="detail-location">🏠 Baki</p>

                <div class="detail-stats-row">
                    <div class="detail-stat-box stat-primary">
                        <div class="stat-label">Qiymət</div>
                        <div class="stat-value-primary">120₼/saat</div>
                    </div>
                    <div class="detail-stat-box stat-blue">
                        <div class="stat-label">Reytinq</div>
                        <div class="stat-value-blue">⭐ 4.5</div>
                    </div>
                    <div class="detail-stat-box stat-orange">
                        <div class="stat-label">Rəylər</div>
                        <div class="stat-value-orange">127</div>
                    </div>
                </div>

                <div class="detail-actions">
                    <button class="btn-action-primary" onclick="openReservationModal()">Rezerv Et</button>
                    <button class="btn-action-secondary">Mesaj Göndər</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Field Images Gallery -->
    <div class="detail-card">
        <h2 class="detail-card-title">Meydança Şəkilləri</h2>

        <div class="field-images-gallery">
            <div class="main-image-container">
                <img src="assets/img/WhatsApp Şəkil 2025-06-02 saat 15.17.05_c54a2834.jpg" alt="Mini Futbol Arena - Əsas Şəkil" class="gallery-main-image">
                <span class="image-label">Əsas Şəkil</span>
            </div>

            <div class="auxiliary-images">
                <div class="auxiliary-image-item">
                    <img src="assets/img/WhatsApp Şəkil 2025-06-02 saat 15.17.05_c54a2834.jpg" alt="Köməkçi Şəkil 1" class="gallery-aux-image">
                    <span class="image-label-small">Köməkçi Şəkil 1</span>
                </div>
                <div class="auxiliary-image-item">
                    <img src="assets/img/WhatsApp Şəkil 2025-06-02 saat 15.17.05_c54a2834.jpg" alt="Köməkçi Şəkil 2" class="gallery-aux-image">
                    <span class="image-label-small">Köməkçi Şəkil 2</span>
                </div>
                <div class="auxiliary-image-item">
                    <img src="assets/img/WhatsApp Şəkil 2025-06-02 saat 15.17.05_c54a2834.jpg" alt="Köməkçi Şəkil 3" class="gallery-aux-image">
                    <span class="image-label-small">Köməkçi Şəkil 3</span>
                </div>
                <div class="auxiliary-image-item">
                    <img src="assets/img/WhatsApp Şəkil 2025-06-02 saat 15.17.05_c54a2834.jpg" alt="Köməkçi Şəkil 4" class="gallery-aux-image">
                    <span class="image-label-small">Köməkçi Şəkil 4</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Two Column Layout -->
    <div class="detail-two-column">
        <!-- Left Column -->
        <div class="detail-column">
            <!-- Field Information -->
            <div class="detail-card detail-info-card">
                <h2 class="detail-card-title">Meydança Məlumatları</h2>

                <div class="detail-info-row">
                    <span class="info-label">Şəhər</span>
                    <span class="info-value">Baki</span>
                </div>

                <div class="detail-info-row">
                    <span class="info-label">Ünvan</span>
                    <span class="info-value">Nizami r., 45A</span>
                </div>


                <div class="detail-info-row">
                    <span class="info-label">İşçi Saatları</span>
                    <span class="info-value">08:00 - 23:00</span>
                </div>

                <div class="detail-info-row detail-info-row-last">
                    <span class="info-label">Telefon</span>
                    <span class="info-value">+994 50 XXX XX XX</span>
                </div>
            </div>

            <!-- Services -->
            <div class="detail-card">
                <h2 class="detail-card-title">Xidmətlər</h2>

                <div class="services-list">
                    <div class="service-item">
                        <span class="service-check">✓</span>
                        <span>Şual meydançası</span>
                    </div>
                    <div class="service-item">
                        <span class="service-check">✓</span>
                        <span>Dəmir kafestir</span>
                    </div>
                    <div class="service-item">
                        <span class="service-check">✓</span>
                        <span>Soyunma otağı</span>
                    </div>
                    <div class="service-item">
                        <span class="service-check">✓</span>
                        <span>Şower</span>
                    </div>
                    <div class="service-item">
                        <span class="service-check">✓</span>
                        <span>Parklandırma</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="detail-column">
            <!-- Available Time Slots -->
            <div class="detail-card time-slots-card">
                <h2 class="detail-card-title">Boş Saatlar</h2>

                <div class="time-slots">
                    <button class="time-slot-available">🕐 16:00 - 17:00</button>
                    <button class="time-slot-available">🕐 17:00 - 18:00</button>
                    <button class="time-slot-available">🕐 18:00 - 19:00</button>
                    <button class="time-slot-available">🕐 19:00 - 20:00</button>
                    <button class="time-slot-available">🕐 20:00 - 21:00</button>
                </div>
            </div>

            <!-- Reviews -->
            <div class="detail-card">
                <h2 class="detail-card-title">Rəylər</h2>
                <p class="reviews-summary">127 rəy (⭐ 4.5 ortalama)</p>

                <div class="reviews-list">
                    <div class="review-item">
                        <div class="review-avatar review-avatar-green">R</div>
                        <div class="review-content">
                            <div class="review-author">Rəşad B.</div>
                            <div class="review-text">Xoş meydança, təmiz və əlverişli</div>
                        </div>
                    </div>

                    <div class="review-item">
                        <div class="review-avatar review-avatar-blue">A</div>
                        <div class="review-content">
                            <div class="review-author">Azər K.</div>
                            <div class="review-text">Bahalı amma xidmət yüksəkdir</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Reservation Modal -->
<div id="reservationModal" class="modal" style="display: none;">
    <div class="modal-content modal-large">
        <div class="modal-header">
            <h2>Meydança Rezervasiyası</h2>
            <span class="modal-close" onclick="closeReservationModal()">&times;</span>
        </div>

        <!-- Progress Steps -->
        <div class="modal-steps">
            <div class="step active" data-step="1">
                <div class="step-number">1</div>
                <div class="step-label">Tarix & Saat</div>
            </div>
            <div class="step" data-step="2">
                <div class="step-number">2</div>
                <div class="step-label">Şəxsi Məlumatlar</div>
            </div>
            <div class="step" data-step="3">
                <div class="step-number">3</div>
                <div class="step-label">Ödəniş</div>
            </div>
        </div>

        <div class="modal-body">
            <form id="reservationForm">
                <!-- Step 1: Date & Time Selection -->
                <div class="form-step active" data-step="1">
                    <h3 class="step-title">Rezervasiya Məlumatları</h3>

                    <div class="form-group">
                        <label for="reservationDate">Tarix *</label>
                        <input type="date" id="reservationDate" class="form-input" required min="">
                    </div>

                    <div class="form-group">
                        <label>Boş Saatlar *</label>
                        <div id="availableSlots" class="time-slots-grid">
                            <!-- Time slots will be loaded here -->
                        </div>
                        <input type="hidden" id="selectedTimeSlot" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="duration">Müddət *</label>
                            <select id="duration" class="form-input" required onchange="updateTotal()">
                                <option value="1">1 saat</option>
                                <option value="2">2 saat</option>
                                <option value="3">3 saat</option>
                                <option value="4">4 saat</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="playerCount">İştirakçı sayı</label>
                            <input type="number" id="playerCount" class="form-input" min="1" max="22" value="10">
                        </div>
                    </div>

                    <div class="reservation-total">
                        <div class="total-label">Ümumi məbləğ:</div>
                        <div class="total-amount" id="totalAmount">120₼</div>
                    </div>

                    <button type="button" class="btn-large btn-primary" onclick="nextStep(2)">Növbəti</button>
                </div>

                <!-- Step 2: Personal Information -->
                <div class="form-step" data-step="2">
                    <h3 class="step-title">Şəxsi Məlumatlar</h3>

                    <div class="form-group">
                        <label for="customerName">Ad Soyad *</label>
                        <input type="text" id="customerName" class="form-input" required placeholder="Adınızı daxil edin">
                    </div>

                    <div class="form-group">
                        <label for="customerEmail">Email *</label>
                        <input type="email" id="customerEmail" class="form-input" required placeholder="email@example.com">
                    </div>

                    <div class="form-group">
                        <label for="customerPhone">Telefon *</label>
                        <input type="tel" id="customerPhone" class="form-input" required placeholder="+994 XX XXX XX XX">
                    </div>

                    <div class="form-group">
                        <label for="customerNote">Qeyd (istəyə bağlı)</label>
                        <textarea id="customerNote" class="form-input" rows="3" placeholder="Əlavə qeydləriniz..."></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-large btn-secondary" onclick="prevStep(1)">Geri</button>
                        <button type="button" class="btn-large btn-primary" onclick="nextStep(3)">Növbəti</button>
                    </div>
                </div>

                <!-- Step 3: Payment -->
                <div class="form-step" data-step="3">
                    <h3 class="step-title">Ödəniş Məlumatları</h3>

                    <div class="payment-summary-box">
                        <div class="summary-row">
                            <span>Meydança:</span>
                            <strong id="summaryField"></strong>
                        </div>
                        <div class="summary-row">
                            <span>Tarix:</span>
                            <strong id="summaryDate"></strong>
                        </div>
                        <div class="summary-row">
                            <span>Saat:</span>
                            <strong id="summaryTime"></strong>
                        </div>
                        <div class="summary-row">
                            <span>Müddət:</span>
                            <strong id="summaryDuration"></strong>
                        </div>
                        <div class="summary-row summary-total">
                            <span>Ümumi məbləğ:</span>
                            <strong id="summaryTotal"></strong>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Kart Nömrəsi *</label>
                        <div id="card-number-element-modal" class="stripe-element">
                            <!-- Stripe Card Number Element -->
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Son İstifadə Tarixi *</label>
                            <div id="card-expiry-element-modal" class="stripe-element">
                                <!-- Stripe Card Expiry Element -->
                            </div>
                        </div>

                        <div class="form-group">
                            <label>CVC *</label>
                            <div id="card-cvc-element-modal" class="stripe-element">
                                <!-- Stripe Card CVC Element -->
                            </div>
                        </div>
                    </div>

                    <div id="card-errors-modal" class="error-message"></div>

                    <div class="form-actions">
                        <button type="button" class="btn-large btn-secondary" onclick="prevStep(2)">Geri</button>
                        <button type="submit" class="btn-large btn-primary" id="submitReservation">
                            <span id="submitText">Ödəniş et və Təsdiqlə</span>
                            <span id="submitLoader" class="spinner" style="display: none;"></span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>