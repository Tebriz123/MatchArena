@model List<GetFieldItemVM>
<main>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 class="section-title">Meydançalar</h1>
            <p class="section-subtitle">Ən yaxşı meydançaları tap və onlarını rezerv et.</p>
        </div>
        <a href="create-field.html" class="btn btn-primary" id="createFieldBtn" style="display: none; white-space: nowrap;">
            ⚽ Meydança Yarat
        </a>
    </div>

    <p class="fields-count">5 meydança tapıldı</p>

    <div class="cards-grid">
      @foreach (GetFieldItemVM field in Model)
        {
            <a asp-action="Detail" asp-route-id="@field.Id" class="field-card field-card-link">
                <div class="card-image">
                    <img src="@field.Image" alt="Mini Futbol Arena">
                    <div class="rating">⭐ 4.5</div>
                    <div class="field-price-badge">@field.PricePerHour₼/saat</div>
                </div>
                <div class="card-content">
                    <div class="team-badge">🏀 MEYDANCA</div>
                    <h3 class="card-title">@field.Name</h3>
                    <div class="card-subtitle">🏠 @field.City • @field.Address</div>
                    <div class="field-info-text">🕐 @field.StartTime - @field.EndTime</div>
                    <div class="field-review-text">⭐ 4.5 (127 rəy)</div>
                    <div class="card-buttons"><span class="btn-small">Rezerv et →</span></div>
                </div>
            </a>
        }
    </div>
</main>