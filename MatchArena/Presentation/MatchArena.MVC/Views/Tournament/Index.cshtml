@model List<GetTournamentItemVM>
<main>
    <h1 class="section-title">Turnirlər</h1>
    <p class="section-subtitle">Rəqabətli turnirlərə qoşul və komandanı sına.</p>

    <p class="tournaments-count">5 turnir tapıldı</p>

    <div class="cards-grid">
       @foreach (GetTournamentItemVM tournament in Model)
        {
            <div class="tournament-card">
                <div class="card-image"><img src="@tournament.Logo" alt="Bakı Futbol Liqası"><span class="tournament-status-badge tournament-status-active">@tournament.Status</span></div>
                <div class="card-content">
                    <div class="team-badge">🏆 TURNİR</div>
                    <h3 class="card-title">@tournament.Name</h3>
                    <div class="prize-badge">⭐ @tournament.PrizeFund₼ MÜKAFAT</div>
                    <div class="tournament-details">
                        <div class="tournament-detail-item">📅 @tournament.StartDate - @tournament.EndDate</div>
                        <div class="tournament-detail-item">📍 @tournament.City</div>
                        <div class="tournament-detail-item">👥 @tournament.MaxTeams komanda </div>
                    </div>
                    <div class="card-buttons"><a asp-action="Detail" asp-route-id="@tournament.id" class="btn-small">Ətraflı →</a></div>
                </div>
            </div>

        }
    </div>
</main>
