@model PostTournamentVM
<main>
    <div class="form-container">
        <h1 class="section-title">Yeni Turnir Yarat</h1>
        <p class="section-subtitle">Yeni turnir təşkil edin və idarə edin</p>
        <form method="post" asp-action="Create" asp-controller="Tournament" enctype="multipart/form-data" class="create-form" id="createTournamentForm">
            <div class="form-section">
                <h3 class="form-section-title">Əsas Məlumatlar</h3>

                <div class="form-group">
                    <label asp-for="Name" class="form-label">Tournament Name *</label>
                    <input asp-for="Name" class="form-input" placeholder="Tournament Name">
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="City" class="form-label">City *</label>
                        <input asp-for="City" class="form-input" placeholder="City">
                        <span asp-validation-for="City"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address" class="form-label">Address *</label>
                        <input asp-for="Address" class="form-input" placeholder="Address">
                        <span asp-validation-for="Address"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Photo" class="form-label">Tournament Image</label>
                    <input asp-for="Photo" class="form-input" accept="image/*">
                    <span asp-validation-for="Photo"></span>
                </div>

            </div>

            <div class="form-section">
                <h3 class="form-section-title">Tarix və Vaxt</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="StartDate" class="form-label">Start Date *</label>
                        <input asp-for="StartDate" type="datetime-local" class="form-input">
                        <span asp-validation-for="StartDate"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EndDate" class="form-label">End Date *</label>
                        <input asp-for="EndDate" type="datetime-local" class="form-input">
                        <span asp-validation-for="EndDate"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="RegistrationDeadline" class="form-label">Registration Deadline *</label>
                        <input asp-for="RegistrationDeadline" type="datetime-local" class="form-input">
                        <span asp-validation-for="RegistrationDeadline"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Turnir Parametrləri</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="MaxTeams" class="form-label">Max Teams *</label>
                        <input asp-for="MaxTeams" class="form-input" placeholder="16">
                        <span asp-validation-for="MaxTeams"></span>
                    </div>

                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="EntryFee" class="form-label">Giriş Haqqı (₼)</label>
                        <input asp-for="EntryFee" class="form-input" placeholder="0">
                        <span asp-validation-for="EntryFee"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PrizeFund" class="form-label">Mükafat Fondu (₼)</label>
                        <input asp-for="PrizeFund" class="form-input" placeholder="0">
                        <span asp-validation-for="PrizeFund"></span>
                    </div>
                </div>

            </div>

            <div class="form-section">
                <h3 class="form-section-title">Əlavə Məlumatlar</h3>

                <div class="form-group">
                    <label asp-for="Status" class="form-label">Status *</label>
                    <select asp-for="Status" class="form-input">
                        @foreach (TournamentStatus tStatus in Enum.GetValues(typeof(TournamentStatus)))
                        {
                            <option value="@((int)tStatus)">@tStatus.ToString()</option>
                        }
                    </select>
                    <span asp-validation-for="Status"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">Təsvir</label>
                    <textarea asp-for="Description" class="form-textarea" rows="5" placeholder="Turnir haqqında ətraflı məlumat yazın..."></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="history.back()">Ləğv et</button>
                <button type="submit" class="btn btn-primary">Turnir Yarat</button>
            </div>
        </form>
    </div>
</main>
