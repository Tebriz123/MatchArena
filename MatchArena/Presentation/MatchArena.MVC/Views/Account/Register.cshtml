@model RegisterVM
<main>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Hesab yaradın</h1>
                <p class="auth-subtitle">MatchArena ailəsinə qoşulun</p>
            </div>

            <form method="post" class="auth-form" id="registerForm">
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" class="form-input" required placeholder="Name">
                        <span class="text-danger" asp-validation-for="Name"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Surname" class="form-label">Surname</label>
                        <input asp-for="Surname" class="form-input" required placeholder="Surname">
                        <span class="text-danger" asp-validation-for="Surname"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-input" required placeholder="Username">
                        <span class="text-danger" asp-validation-for="Username"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-input" required placeholder="example@email.com">
                    <span class="text-danger" asp-validation-for="Email"></span>
                </div>


                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-input" required placeholder="Password" minlength="6">
                    <span class="text-danger" asp-validation-for="Password"></span>
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="terms" id="terms" required>
                        <span><a href="#" class="auth-link">İstifadə şərtləri</a> və <a href="#" class="auth-link">Məxfilik siyasəti</a> ilə razıyam</span>
                    </label>
                </div>
                <button type="submit" class="btn btn-primary auth-btn">Qeydiyyatdan keç</button>
            </form>

            <div class="auth-divider">
                <span>və ya</span>
            </div>

            <div class="auth-footer">
                Artıq hesabınız var? <a asp-action="Login" class="auth-link">Daxil ol</a>
            </div>
        </div>
    </div>
</main>
