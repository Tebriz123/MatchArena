@model GetTeamVM
<main class="team-detail-container">
    @if (TempData["Success"] != null)
    {
        <div style="background:#22c55e;color:white;padding:1rem;border-radius:0.5rem;margin-bottom:1rem;">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:#ef4444;color:white;padding:1rem;border-radius:0.5rem;margin-bottom:1rem;">@TempData["Error"]</div>
    }

    <a href="teams.html" class="team-back-link">← Komandalar səhifəsinə qayıt</a>

    <div class="team-profile-card">
        <div class="team-profile-grid">
            <div class="team-logo"><img src="@Model.Logo" alt="@Model.Name"></div>

            <div class="team-profile-info">
                <h1>@Model.Name</h1>
                <p class="team-profile-subtitle">Kapitan: @Model.CaptainName • 🏠 @Model.City </p>

                <div class="team-stats-cards">
                    <div class="stat-card stat-card-members">
                        <div class="stat-card-label">Oyunçular</div>
                        <div class="stat-card-value stat-card-value-members">@Model.PlayerCount/@Model.MaxPlayer</div>
                    </div>
                    <div class="stat-card stat-card-rating">
                        <div class="stat-card-label">Reytinq</div>
                        <div class="stat-card-value stat-card-value-rating">⭐ 4.9</div>
                    </div>
                    <div class="stat-card stat-card-games">
                        <div class="stat-card-label">Oyunlar</div>
                        <div class="stat-card-value stat-card-value-games">@Model.GameCount</div>
                    </div>
                </div>

                <div class="team-action-buttons">
                    @if (User.Identity?.IsAuthenticated == true && ViewBag.CaptainTeamId != null)
                    {
                        <form asp-action="SendInvite" asp-controller="Team" method="post" style="display:inline;">
                            <input type="hidden" name="playerId" value="@Model.Id" />
                            <input type="hidden" name="teamId" value="@ViewBag.CaptainTeamId" />
                            <button type="submit" class="btn-invite">Komandaya Dəvət Et</button>
                        </form>
                    }
                    <button class="btn-message" onclick="alert('Mesaj göndərmək funksiyası tezliklə əlavə ediləcək')">Mesaj Göndər</button>
                    <button class="btn-challenge" id="challengeTeamBtn" style="background: #f97316; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 0.5rem; cursor: pointer; font-size: 1rem; font-weight: 600; transition: all 0.3s;">⚽ Oyuna Dəvət Et</button>
                </div>
            </div>
        </div>
    </div>

    <div class="team-content-grid">
        <!-- Left Column -->
        <div>
            <div class="team-info-card">
                <h2>Komanda Məlumatları</h2>

                <div class="team-info-row">
                    <span class="team-info-label">Kapitan</span>
                    <span class="team-info-value">@Model.CaptainName</span>
                </div>

                <div class="team-info-row">
                    <span class="team-info-label">Şəhər</span>
                    <span class="team-info-value">@Model.City</span>
                </div>

                <div class="team-info-row">
                    <span class="team-info-label">Üzv Sayı</span>
                    <span class="team-info-value">@Model.PlayerCount</span>
                </div>

            </div>

            <div class="team-stats-card">
                <h2>Komanda Statistikası</h2>

                <div class="team-stat-row">
                    <span class="team-stat-label">Ümumi Oyunlar</span>
                    <span class="team-stat-value">67</span>
                </div>

                <div class="team-stat-row">
                    <span class="team-stat-label">Qələbələr</span>
                    <span class="team-stat-value">45</span>
                </div>

                <div class="team-stat-row">
                    <span class="team-stat-label">Bərabərlər</span>
                    <span class="team-stat-value">12</span>
                </div>

                <div class="team-stat-row">
                    <span class="team-stat-label">Məğlubiyyətlər</span>
                    <span class="team-stat-value">10</span>
                </div>

                <div class="team-stat-row">
                    <span class="team-stat-label">Qələbə Faizi</span>
                    <span class="team-stat-value team-stat-win-rate">67.2%</span>
                </div>

                <div class="team-stat-row">
                    <span class="team-stat-label">Atılan Qollar</span>
                    <span class="team-stat-value">142</span>
                </div>

                <div class="team-stat-row">
                    <span class="team-stat-label">Yeyilən Qollar</span>
                    <span class="team-stat-value">78</span>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div>
            <div class="team-players-card">
                <h2>Komanda Oyunçuları (@Model.PlayerCount)</h2>

                <div class="team-players-list">
                    @foreach (var player in Model.PlayerDtos)
                    {
                        <a href="player-detail.html" class="player-card player-card-0">
                            <div class="player-info">
                                <div class="player-name">@player.Name @player.Surname</div>
                                <div class="player-details">@player.Position • @player.Age yaş</div>
                            </div>
                            <div class="player-stats">
                                <div class="player-rating player-rating-0">⭐ 4.9</div>
                            </div>
                            <div class="player-arrow">→</div>
                        </a>
                    }
                </div>
            </div>

            <div class="team-reviews-card">
                <h2>Komanda Rəyləri</h2>
                <p class="reviews-subtitle">12 rəy (⭐ 4.8 ortalama)</p>

                <div class="reviews-list">
                    <div class="review-item">
                        <div class="review-avatar review-avatar-1">F</div>
                        <div class="review-content">
                            <div class="review-name">Fuad Əhmədov</div>
                            <div class="review-text">Çox güclü və peşəkar komanda. Birlikdə oynamaq zövq verir!</div>
                        </div>
                    </div>

                    <div class="review-item">
                        <div class="review-avatar review-avatar-2">R</div>
                        <div class="review-content">
                            <div class="review-name">Rəşad Mustafayev</div>
                            <div class="review-text">Əla komanda, yüksək səviyyəli oyunçular. Məsləhət görürəm!</div>
                        </div>
                    </div>

                    <div class="review-item">
                        <div class="review-avatar review-avatar-1">E</div>
                        <div class="review-content">
                            <div class="review-name">Emil Qasımov</div>
                            <div class="review-text">Komanda ruhu çox güclüdür. Hər kəsə tövsiyə edirəm.</div>
                        </div>
                    </div>

                    <div class="review-item">
                        <div class="review-avatar review-avatar-2">N</div>
                        <div class="review-content">
                            <div class="review-name">Nicat Həsənov</div>
                            <div class="review-text">Professional yanaşma, keyfiyyətli oyun. 5 ulduz!</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>