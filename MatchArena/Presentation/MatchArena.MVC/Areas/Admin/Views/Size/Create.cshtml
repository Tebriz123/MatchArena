@model PostSizeVM

<main>
    <div class="form-container">
        <h1 class="section-title">Yeni Size Yarat</h1>
        <p class="section-subtitle">Məhsul olcusu əlavə edin</p>

        <form method="post" class="create-form" id="createSizeForm">
            <div class="form-section">
                <h3 class="form-section-title">Əsas Məlumatlar</h3>

                <div class="form-group">
                    <label asp-for="Name" class="form-label">Size Name</label>
                    <input asp-for="Name" class="form-input" required placeholder="Size">
                    <span asp-validation-for="Name"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.location.href='admin-panel.html'">Ləğv et</button>
                <button type="submit" class="btn btn-primary">Ölçünü Yenilə</button>
            </div>
        </form>
    </div>
</main>