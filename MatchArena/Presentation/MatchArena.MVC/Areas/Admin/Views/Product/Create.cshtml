@using MatchArena.MVC.ViewModels.Products
@model PostProductVM

@{
    ViewData["Title"] = "Yeni Məhsul Yarat";
}

<main>
    <div class="form-container">
        <h1 class="section-title">Yeni Məhsul Yarat</h1>
        <p class="section-subtitle">Yeni məhsul əlavə edin</p>

        <form class="create-form" asp-action="Create" asp-controller="Product" asp-area="Admin"
              method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-section">
                <h3 class="form-section-title">Əsas Məlumatlar</h3>

                <div class="form-group">
                    <label asp-for="Name" class="form-label">Məhsul Adı *</label>
                    <input asp-for="Name" class="form-input" placeholder="Məs. Futbol Topu - Pro" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="form-label">Kateqoriya *</label>
                    <select asp-for="CategoryId" class="form-input">
                        <option value="">Kateqoriya seçin</option>
                        @foreach (var cat in ViewBag.Categories as IEnumerable<MatchArena.MVC.ViewModels.Category.GetCategoryItemVM>)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PrimaryPhoto" class="form-label">Əsas Şəkil *</label>
                    <input asp-for="PrimaryPhoto" type="file" class="form-input" accept="image/*" />
                    <small class="form-hint">PNG, JPG, JPEG</small>
                    <span asp-validation-for="PrimaryPhoto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AdditionalPhotos" class="form-label">Əlavə Şəkillər</label>
                    <input asp-for="AdditionalPhotos" type="file" class="form-input" accept="image/*" multiple />
                    <small class="form-hint">Birdən çox seçə bilərsiniz</small>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">Təsvir *</label>
                    <textarea asp-for="Description" class="form-textarea" rows="4"
                              placeholder="Məhsul haqqında məlumat yazın..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Qiymət</h3>

                <div class="form-group">
                    <label asp-for="Price" class="form-label">Qiymət (₼) *</label>
                    <input asp-for="Price" type="number" class="form-input" min="0" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Rənglər</h3>

                <div class="form-group">
                    <label class="form-label">Mövcud Rənglər *</label>
                    <div class="form-checkbox-group">
                        @foreach (var color in ViewBag.Colors as IEnumerable<MatchArena.MVC.ViewModels.Colors.GetColorItemVM>)
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" name="ColorIds" value="@color.Id"
                                       @(Model != null && Model.ColorIds != null && Model.ColorIds.Contains(color.Id) ? "checked" : "") />
                                <span>@color.Name</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Ölçülər</h3>

                <div class="form-group">
                    <label class="form-label">Mövcud Ölçülər *</label>
                    <div class="form-checkbox-group">
                        @foreach (var size in ViewBag.Sizes as IEnumerable<MatchArena.MVC.ViewModels.Sizes.GetSizeItemVM>)
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" name="SizeIds" value="@size.Id"
                                       @(Model != null && Model.SizeIds != null && Model.SizeIds.Contains(size.Id) ? "checked" : "") />
                                <span>@size.Name</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" asp-controller="Product" asp-area="Admin"
                   class="btn btn-secondary">Ləğv et</a>
                <button type="submit" class="btn btn-primary">Məhsul Yarat</button>
            </div>
        </form>
    </div>
</main>
