# Copy to .env and fill with REAL values. Never commit .env.
# All previously committed secrets are public — rotate them before using.

# --- Database ---
SA_PASSWORD=Your_Strong!Passw0rd

# --- JWT ---
JWT_ISSUER=https://your-api-domain/
JWT_AUDIENCE=https://your-mvc-domain/
JWT_SECRET_KEY=generate-a-new-long-random-secret

# --- Seeded admin account ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change_This_Strong_Password1

# --- Email (Mailtrap or real SMTP) ---
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Stripe (test keys) ---
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_SUCCESS_URL=https://your-mvc-domain/payments/success
STRIPE_CANCEL_URL=https://your-mvc-domain/payments/cancel
