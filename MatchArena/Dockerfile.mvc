# MatchArena MVC — ASP.NET Core MVC frontend (.NET 8)
# Build context must be the solution directory (where MatchArena.sln lives).

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore "Presentation/MatchArena.MVC/MatchArena.MVC.csproj"
RUN dotnet publish "Presentation/MatchArena.MVC/MatchArena.MVC.csproj" \
    -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
EXPOSE 8080
# Bind to the platform-provided $PORT (Render/Railway inject it); default 8080 locally.
COPY --from=build /app/publish .
ENTRYPOINT ["sh", "-c", "ASPNETCORE_URLS=http://+:${PORT:-8080} exec dotnet MatchArena.MVC.dll"]
